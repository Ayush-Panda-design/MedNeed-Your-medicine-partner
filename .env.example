# Copy to .env.local and fill in. Never commit real secrets.

# Public URL of the site (used for Google OAuth redirect and CSRF origin checks).
APP_URL=http://localhost:3000

# REQUIRED IN PRODUCTION: long random string (32+ chars). Generate: openssl rand -base64 48
# Signs sessions and encrypts 2FA secrets. Changing it signs everyone out and breaks stored 2FA.
AUTH_SECRET=

# Postgres. Leave empty in development to use the built-in local database (PGlite, stored in ~/.medneed/pglite).
# DATABASE_URL=postgresql://user:password@localhost:5432/medneed
# PGLITE_DIR=

# First admin, created on first start. Required in production; in development defaults to
# admin@medneed.local / Admin@12345. 2FA setup is forced at first sign-in.
# ADMIN_EMAIL=
# ADMIN_PASSWORD=

# Sign in with Google (optional). Redirect URI to register: {APP_URL}/api/auth/google/callback
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# SMS for OTP: "console" (development, prints the code) or "twilio"
SMS_DRIVER=console
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_FROM=

# Catalog images. In development files go to ~/.medneed/uploads (or UPLOAD_DIR).
# In production set S3_* (any S3-compatible store) or point UPLOAD_DIR at a persistent disk.
# UPLOAD_DIR=
# S3_BUCKET=
# S3_REGION=ap-south-1
# S3_ENDPOINT=            # only for non-AWS stores (R2, MinIO, ...)
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_PUBLIC_URL=          # public base URL the bucket is served from

# Set to 1 to skip loading the fictional sample medicines in development.
# MEDNEED_NO_SAMPLE_DATA=1

# Development only: stage a CSV dataset as unverified drafts (see README, "Staging a large dataset").
# MEDNEED_DATASET=C:\\path\\to\\indian_medicine_data.csv
# MEDNEED_DATASET_LIMIT=30000

# Inventory rules (optional)
# Batches with fewer than this many days to expiry are not sold online (default 30).
INVENTORY_MIN_SHELF_DAYS=30
# Batches expiring within this many days appear in the expiry alert (default 90).
INVENTORY_EXPIRY_ALERT_DAYS=90

# Phase 5: shared secret for the stock-hold expiry job (at least 16 characters). Leave unset to disable the route.
# CRON_SECRET=
# Orders one customer may place per 10 minutes (default 10).
# ORDER_RATE_LIMIT=10

# Phase 6: Razorpay (Dashboard > Settings > API Keys, and Webhooks). Start with test keys.
# RAZORPAY_KEY_ID=rzp_test_xxxxxxxx
# RAZORPAY_KEY_SECRET=
# RAZORPAY_WEBHOOK_SECRET=
# Payment attempts one customer may make per 10 minutes (default 20).
# PAYMENT_RATE_LIMIT=20

# Phase 7: prescription files (private). Development needs nothing; production needs the key and one place to store files.
# 64 hex characters: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"   KEEP A BACKUP OF THIS KEY.
# PRESCRIPTION_ENC_KEY=
# A persistent private folder (production without S3):
# PRESCRIPTION_DIR=/var/lib/medneed/prescriptions
# Or a PRIVATE S3 bucket (never public); also uses S3_REGION, S3_ENDPOINT, S3_ACCESS_KEY_ID, S3_SECRET_ACCESS_KEY:
# PRESCRIPTION_S3_BUCKET=
# Prescription uploads one customer may make per hour (default 10).
# RX_UPLOAD_LIMIT=10


# Phase 8: customer messages. Development needs nothing (messages print in the server terminal).
# The queue is sent right after each order change; this job is the safety net that retries failures (same secret as above):
#   curl -X POST https://YOUR-SITE/api/internal/expire-orders -H "x-cron-secret: $CRON_SECRET"      (every 2-5 minutes)
# Email: EMAIL_DRIVER=resend (RESEND_API_KEY) or brevo (BREVO_API_KEY); EMAIL_FROM="MedNeed <orders@your-domain>" must be a verified sender.
# EMAIL_DRIVER=resend
# RESEND_API_KEY=
# BREVO_API_KEY=
# EMAIL_FROM=
# SMS (see Phase 2 notes): SMS_DRIVER=twilio with TWILIO_ACCOUNT_SID, TWILIO_AUTH_TOKEN, TWILIO_FROM. India needs DLT-registered templates.
# WhatsApp Business Cloud API: every message is a Meta-approved template named mn_<event> (see README).
# WHATSAPP_DRIVER=cloud
# WHATSAPP_TOKEN=
# WHATSAPP_PHONE_ID=
# WHATSAPP_LANG=en
# Set to 0 to send only from the scheduled job (not right after each change).
# NOTIFICATIONS_INLINE=1

# AI features (Google Gemini) — optional. Smart search + "Ask about this medicine" turn on when keys are present.
# Free-tier keys are rate-limited per key, so list several and they are rotated automatically (responses are cached too).
# GEMINI_API_KEYS=key1,key2,key3
# GEMINI_MODEL=gemini-2.0-flash


