# Staging environment for docker-compose.staging.yml (copy to .env.staging; never commit the filled copy).
# Generate secrets with:  openssl rand -base64 48     and for 64-hex keys:  openssl rand -hex 32

# Public HTTPS address of the staging site (no trailing slash).
APP_URL=https://staging.your-domain.in

# Password-protects the whole staging site (browser login box) and hides it from search engines. Format user:password.
STAGING_BASIC_AUTH=client:change-this-long-password

# Database password (docker-compose builds DATABASE_URL from it). If you use a managed Postgres instead, set DATABASE_URL.
POSTGRES_PASSWORD=
# DATABASE_URL=postgresql://user:password@host:5432/medneed?sslmode=require

AUTH_SECRET=
CRON_SECRET=
PRESCRIPTION_ENC_KEY=

# First admin account (2FA is set up on first sign-in). Use a real mailbox and a strong password.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Fictional sample medicines so the client has something to click through. Remove on the live site.
MEDNEED_DEMO_DATA=1

# Razorpay TEST keys only on staging.
RAZORPAY_KEY_ID=rzp_test_xxxxxxxx
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# How many reverse proxies sit in front of the app (Caddy/Nginx = 1). Used to read the real client IP safely.
TRUSTED_PROXY_HOPS=1

# Messages: SMS OTP needs a real provider in production mode. For a demo, use email + password sign-in,
# or configure Twilio. Email/WhatsApp are optional (orders still work; messages are just not sent).
SMS_DRIVER=twilio
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_FROM=
# EMAIL_DRIVER=resend
# RESEND_API_KEY=
# EMAIL_FROM=MedNeed <orders@your-domain.in>

# Optional: Google sign-in (register {APP_URL}/api/auth/google/callback), Gemini AI keys.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GEMINI_API_KEYS=key1,key2

# Recommended before launch: bot check on OTP sign-in (dash.cloudflare.com → Turnstile, free) and error alerts.
# TURNSTILE_SITE_KEY=
# TURNSTILE_SECRET_KEY=
# ALERT_WEBHOOK_URL=https://hooks.slack.com/services/...
